<%- include('partials/header') %>
<section class="wrap auth">
  <div class="auth-card">
    <h1>Create your account</h1>
    <p class="muted">Takes 30 seconds. Get ₹200 off your first order with FIRST200.</p>
    <form method="post" action="/signup" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Full name<input name="name" value="<%= form.name || '' %>" autocomplete="name"><% if (errors.name) { %><em><%= errors.name %></em><% } %></label>
      <label>Email<input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email"><% if (errors.email) { %><em><%= errors.email %></em><% } %></label>
      <label>Mobile number<input type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel"><% if (errors.phone) { %><em><%= errors.phone %></em><% } %></label>
      <label>Password<input type="password" name="password" autocomplete="new-password"><% if (errors.password) { %><em><%= errors.password %></em><% } %></label>
      <button class="btn wide">Create account</button>
    </form>
    <p class="switch">Already have an account? <a href="/login?next=<%= encodeURIComponent(next) %>">Log in</a></p>
  </div>
</section>
<%- include('partials/footer') %>
